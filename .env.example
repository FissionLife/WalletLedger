# Copy to .env and fill in:  cp .env.example .env     (never commit .env)

# --- Database -------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./walletledger.db
# Postgres (production):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/walletledger?sslmode=require

# --- Telegram -------------------------------------------------------------
# Token from @BotFather (/newbot). Leave empty to run without Telegram.
TELEGRAM_BOT_TOKEN=

# false = long polling (easiest locally, no public URL needed)
# true  = webhook (production; needs HTTPS WEBHOOK_URL and WEBHOOK_SECRET)
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.com/bot/webhook
WEBHOOK_SECRET=

# Only these Telegram chat ids may use the bot (comma-separated). Empty = anyone.
ALLOWED_CHAT_IDS=

# --- Security -------------------------------------------------------------
# Encrypts users' API keys at rest. Generate a random one (see README / commands below).
SECRET_KEY=
# Previous key(s) during rotation, comma-separated. Normally empty.
SECRET_KEY_OLD=

# --- Optional server-side fallback LLM (used when a user has no key of their own)
# DEFAULT_LLM_MODEL=gemini/gemini-2.5-flash
# DEFAULT_LLM_API_KEY=

# --- Behaviour ------------------------------------------------------------
# /bot/simulate_chat lets the caller act as ANY chat id. Local dev only!
ENABLE_DEV_ENDPOINTS=false
# Amounts at/above this need a "yes" confirmation
CONFIRM_THRESHOLD=50000
