# WalletLedger settings. Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is git-ignored. Never commit real tokens or keys.

# --- Database -------------------------------------------------------------------
# Choose ONE backend:
#   sqlite   - a single local file. Zero setup, best for development and personal use.
#   postgres - a database server. Best for production / several users (docker compose up -d).
DB_MODE=sqlite

# sqlite settings
SQLITE_PATH=./walletledger.db

# postgres settings (used when DB_MODE=postgres; match docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=appdb

# Advanced: a full SQLAlchemy URL overrides DB_MODE and the settings above, e.g.
#   DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/walletledger?sslmode=require
# DATABASE_URL=

# --- Security -------------------------------------------------------------------
# Encrypts users' AI keys in the api_keys table. Use a long random value and never change it
# after keys are stored (old keys become unreadable). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Telegram bot ---------------------------------------------------------------
# From @BotFather. Leave empty to disable the bot (POST /bot/simulate_chat still works).
TELEGRAM_BOT_TOKEN=
# false = long polling (local dev, no public URL needed)
# true  = webhook (production): Telegram calls WEBHOOK_URL, which must be public HTTPS
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.example.com/bot/webhook
# Optional: secret Telegram sends with every webhook call (default: derived from the token)
TELEGRAM_WEBHOOK_SECRET=
# Largest statement upload accepted from chat (MB)
MAX_UPLOAD_MB=10

# --- AI (optional server keys) --------------------------------------------------
# Users normally add their own key in chat (/setkey <key>). These server keys are used only
# for users without a key. Several keys = comma-separated, rotated round-robin.
GEMINI_API_KEYS=
OPENAI_API_KEYS=
ANTHROPIC_API_KEYS=
GROQ_API_KEYS=
# Single-key variants (also accepted)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Models are discovered automatically: the gateway asks each provider which models your key can
# use and picks the best one, so you never maintain model names. Turn off with DYNAMIC_MODELS=false.
# Optional pins (override discovery; leave commented unless you need a specific model):
# AI_MODEL_GEMINI=gemini/gemini-flash-latest
# AI_MODEL_OPENAI=openai/gpt-4o-mini
# AI_MODEL_ANTHROPIC=anthropic/claude-3-5-sonnet-20241022
# AI_MODEL_GROQ=groq/llama-3.3-70b-versatile
# OLLAMA_API_BASE=http://localhost:11434

# --- Access control ---------------------------------------------------------------
# Only these Telegram chat ids may use the bot (comma-separated). Empty = anyone.
# Find your id by messaging @userinfobot.
ALLOWED_CHAT_IDS=
# /bot/simulate_chat and the token-less /bot/webhook let the caller act as ANY chat id.
# Leave unset: they are on only while TELEGRAM_BOT_TOKEN is empty (local dev).
# ENABLE_DEV_ENDPOINTS=false
